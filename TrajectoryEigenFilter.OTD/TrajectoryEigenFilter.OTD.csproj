<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Spectral.Reconstructor</AssemblyName>
    <Version>1.1.4</Version>
    <PackageLicenseExpression>SUL-1.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Vestaia/Spectral-Reconstructor</RepositoryUrl>

    <!-- OTD supplies its own assemblies at runtime. Keep the plugin output self-contained
         as one managed plugin DLL by compiling the filter core directly into this assembly. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.7" PrivateAssets="all" />

    <!-- Compile the shared filter implementation directly into the OTD plugin assembly. -->
    <Compile Include="..\TrajectoryEigenFilterCore\ComplexityModel.cs" Link="Core\ComplexityModel.cs" />
    <Compile Include="..\TrajectoryEigenFilterCore\FilterSettings.cs" Link="Core\FilterSettings.cs" />
    <Compile Include="..\TrajectoryEigenFilterCore\SymmetricEigen.cs" Link="Core\SymmetricEigen.cs" />
    <Compile Include="..\TrajectoryEigenFilterCore\TrajectoryFilter.cs" Link="Core\TrajectoryFilter.cs" />
  </ItemGroup>

  <!-- Keep the locally installed OTD plugin synchronized with Release builds.
       Set SkipLocalOtdDeploy=true to build without deploying. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(OpenTabletDriverPluginDirectory)' == ''">
    <OpenTabletDriverPluginDirectory>$(LOCALAPPDATA)\OpenTabletDriver\Plugins\Spectral Reconstructor</OpenTabletDriverPluginDirectory>
  </PropertyGroup>

  <Target Name="DeployLocalOpenTabletDriverPlugin"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(SkipLocalOtdDeploy)' != 'true' and Exists('$(LOCALAPPDATA)\OpenTabletDriver\Plugins')">
    <MakeDir Directories="$(OpenTabletDriverPluginDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(OpenTabletDriverPluginDirectory)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(OpenTabletDriverPluginDirectory)" />
  </Target>
</Project>
